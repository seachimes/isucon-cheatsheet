# inventory のサンプル。hosts にコピーして自分の環境に合わせて編集する。
#   cp hosts.example hosts
#
# 対象ホスト（グループ）をここに書く。
# 例: -e measure_hosts=isu-app / -e pprotein_server_hosts=pprotein_server

[app]
isu-app

[bench]
isu-bench

# app と bench を兼ねる all-in-one 構成の例
# [allinone]
# isu-app

# pprotein サーバ（Akamai/Linode）。別ホスト。
# cloud-init が cloudflared を上げるので、最初から Tunnel SSH で接続する。
# ~/.ssh/config で ProxyCommand を設定する:
#   Host pprotein-ssh.<your-zone>
#     User root
#     ProxyCommand cloudflared access ssh --hostname %h
# service token は TUNNEL_SERVICE_TOKEN_ID / TUNNEL_SERVICE_TOKEN_SECRET を
# 実行シェルで export する（argv に残さない）。
[pprotein_server]
pprotein ansible_host=pprotein-ssh.<your-zone> ansible_user=root
